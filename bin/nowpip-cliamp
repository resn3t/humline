#!/bin/bash
# nowpip <-> cliamp bridge. One short-lived call per user action; prints one
# line of compact JSON ({"ok":false,"error":...} on failure) so the bar never
# has to parse cliamp's full (sometimes multi-MB) job output.
#
#   nowpip-cliamp state                       shuffle/repeat + favorite flag
#   nowpip-cliamp fav [path]                  toggle the current track in favorites
#   nowpip-cliamp shuffle | repeat            toggle shuffle / cycle repeat
#   nowpip-cliamp providers                   configured providers
#   nowpip-cliamp playlists <prov> <off> <n>  one page of a provider's lists
#   nowpip-cliamp load <prov> <id>            load a list and play it
#   nowpip-cliamp targets <path> <off> <n>    writable playlists (+ membership)
#   nowpip-cliamp add <prov> <id> <path>      add the current track to a list
#   nowpip-cliamp remove <id> <path>          remove a track from a local list

set -euo pipefail
# Errors are printed straight to the real stdout (fd 3) so they escape
# command substitutions; set -e then aborts the script.
exec 3>&1

cfg=${XDG_CONFIG_HOME:-$HOME/.config}/cliamp
favfile=$cfg/favorites.toml

fail() { jq -cn --arg e "$1" '{ok:false,error:$e}' >&3; exit 1; }

# cliamp remote call <op> <params> --wait; prints the job result object.
call() {
  local out
  out=$(timeout "${3:-20}" cliamp remote call "$1" --params "$2" --wait 2>&1) || fail "$(tail -n1 <<<"$out" | cut -c1-160)"
  jq -c '.job.result // {}' <<<"$out" 2>/dev/null || fail "bad reply from cliamp"
}

# The live track, as cliamp's TrackInfo JSON. With a path, refuse to act if
# the track changed since the card showed it.
current_track() {
  local path=$1 track
  track=$(timeout 5 cliamp remote state 2>/dev/null | jq -c '.snapshot.track // empty') || true
  [[ -n $track ]] || fail "cliamp is not responding"
  [[ -z $path || $(jq -r .path <<<"$track") == "$path" ]] || fail "track changed"
  printf '%s' "$track"
}

# Favorites use cliamp's own on-disk format and lock (flock on
# favorites.toml.lock, atomic temp+rename), exactly like cliamp's store.
path_line() { jq -rn --arg p "$1" '"path = " + ($p | tojson)'; }

is_fav() {
  [[ -f $favfile ]] || return 1
  awk -v w="$(path_line "$1")" '{ t = $0; gsub(/^[ \t]+|[ \t]+$/, "", t); if (t == w) { f = 1; exit } } END { exit !f }' "$favfile"
}

toggle_fav() {
  local path track want tmp now
  track=$(current_track "$1")
  path=$(jq -r '.path // ""' <<<"$track")
  [[ -n $path ]] || fail "no track"
  want=$(path_line "$path")
  mkdir -p "$cfg"
  exec 9>"$favfile.lock"
  flock -w 5 9 || fail "favorites are locked"
  tmp=$(mktemp "$cfg/.favorites.toml.XXXXXX") || fail "cannot write favorites"
  if is_fav "$path"; then
    awk -v target="$want" '
      function flush() { if (!drop) printf "%s", blk; blk = ""; drop = 0 }
      /^[[:space:]]*\[\[entry\]\][[:space:]]*$/ { flush() }
      { t = $0; gsub(/^[ \t]+|[ \t]+$/, "", t); if (t == target) drop = 1; blk = blk $0 "\n" }
      END { flush() }' "$favfile" >"$tmp"
    state=false
  else
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    jq -r --arg now "$now" '
      def q: tojson;
      "[[entry]]",
      "favorited_at = \($now | q)",
      "path = \(.path | q)",
      "title = \((.title // "") | q)",
      (select((.artist // "") != "") | "artist = \(.artist | q)"),
      (select((.album // "") != "") | "album = \(.album | q)"),
      (select((.genre // "") != "") | "genre = \(.genre | q)"),
      (select((.year // 0) != 0) | "year = \(.year)"),
      (select((.track_number // 0) != 0) | "track_number = \(.track_number)"),
      (select((.duration_secs // 0) != 0) | "duration_secs = \(.duration_secs)"),
      (select(.feed == true) | "feed = true"),
      (select(.realtime == true) | "realtime = true"),
      ((.provider_meta // {}) | to_entries[] | "provider_meta.\(.key) = \(.value | tostring | q)")
    ' <<<"$track" >"$tmp" || { rm -f "$tmp"; fail "cannot build entry"; }
    if [[ -s $favfile ]]; then printf '\n' >>"$tmp"; cat "$favfile" >>"$tmp"; fi
    state=true
  fi
  chmod 644 "$tmp"
  sync "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$favfile" || { rm -f "$tmp"; fail "cannot write favorites"; }
  jq -cn --argjson f "$state" '{ok:true,fav:$f}'
}

local_lists() {
  call provider.playlists '{"provider":"local","offset":0,"limit":200}' |
    jq -c '[.playlists[]? | select(.id != "Favorites" and .id != "Recently Played")]'
}

cmd=${1:-}
shift || true
command -v cliamp >/dev/null || fail "cliamp not installed"

case $cmd in
  state)
    st=$(timeout 5 cliamp remote state 2>/dev/null) || fail "cliamp is not responding"
    path=$(jq -r '.snapshot.track.path // ""' <<<"$st")
    fav=false
    [[ -n $path ]] && is_fav "$path" && fav=true
    jq -c --argjson fav "$fav" '.snapshot | {ok:true, path:(.track.path // ""), shuffle:(.shuffle == true), repeat:(.repeat // "Off"), fav:$fav}' <<<"$st"
    ;;
  fav) toggle_fav "${1:-}" ;;
  shuffle) call shuffle '{}' | jq -c '{ok:true, shuffle:(.shuffle == true)}' ;;
  repeat) call repeat '{}' | jq -c '{ok:true, repeat:(.repeat // "Off")}' ;;
  providers)
    call provider.list '{}' | jq -c '{ok:true, providers:[.providers[]? | {key, name}]}'
    ;;
  playlists)
    prov=${1:?}; off=${2:-0}; n=${3:-20}
    call provider.playlists "$(jq -cn --arg p "$prov" --argjson o "$off" --argjson n "$n" '{provider:$p,offset:$o,limit:$n}')" 60 |
      jq -c '{ok:true, total:(.total // 0), items:[.playlists[]? | {id, name, section:(.section // ""), count:(.track_count // 0)}]}'
    ;;
  load)
    call provider.load "$(jq -cn --arg p "${1:?}" --arg id "${2:?}" '{provider:$p,playlist:$id}')" 60 |
      jq -c '{ok:true, total:(.total // 0)}'
    ;;
  targets)
    # Local playlists first (with membership), then your own Spotify ones.
    path=${1:?}; off=${2:-0}; n=${3:-20}
    items='[]'
    locals=$(local_lists)
    while read -r id; do
      [[ -n $id ]] || continue
      has=$(call provider.tracks "$(jq -cn --arg id "$id" '{provider:"local",playlist:$id,offset:0,limit:200}')" |
        jq --arg p "$path" '[.tracks[]? | select(.path == $p)] | length > 0')
      items=$(jq -c --arg id "$id" --argjson h "${has:-false}" '. + [{provider:"local", id:$id, name:$id, has:$h}]' <<<"$items")
    done <<<"$(jq -r '.[].id' <<<"$locals")"
    provs=$(call provider.list '{}')
    if [[ $path == spotify:track:* || $path == spotify:episode:* ]] &&
      jq -e '.providers[]? | select(.key == "spotify")' <<<"$provs" >/dev/null; then
      page=0
      while :; do
        chunk=$(call provider.playlists "$(jq -cn --argjson o $((page * 200)) '{provider:"spotify",offset:$o,limit:200}')" 60)
        items=$(jq -c --argjson c "$chunk" '. + [$c.playlists[]? | select(.section == "Your playlists") | {provider:"spotify", id, name, has:null}]' <<<"$items")
        page=$((page + 1))
        (( page * 200 < $(jq '.total // 0' <<<"$chunk") && page < 10 )) || break
      done
    fi
    jq -c --argjson o "$off" --argjson n "$n" '{ok:true, total:length, items:.[$o:$o + $n]}' <<<"$items"
    ;;
  add)
    prov=${1:?}; id=${2:?}; track=$(current_track "${3:?}")
    call playlist.add "$(jq -cn --arg p "$prov" --arg id "$id" --argjson t "$track" '{provider:$p,playlist:$id,track:$t}')" 30 >/dev/null
    jq -cn '{ok:true}'
    ;;
  remove)
    id=${1:?}; path=${2:?}
    idx=$(call provider.tracks "$(jq -cn --arg id "$id" '{provider:"local",playlist:$id,offset:0,limit:200}')" |
      jq --arg p "$path" '[.tracks[]? | .path] | index($p) // -1')
    [[ $idx != -1 ]] || fail "not in playlist"
    call playlist.remove "$(jq -cn --arg id "$id" --argjson i "$idx" '{provider:"local",playlist:$id,index:$i}')" >/dev/null
    jq -cn '{ok:true}'
    ;;
  *) fail "unknown command: $cmd" ;;
esac
